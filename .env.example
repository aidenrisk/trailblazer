# Which provider `get_model()` builds. openrouter | anthropic
LLM_PROVIDER=openrouter

# OpenRouter (primary). Model id verified against https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4.5

# Anthropic Console API key (optional second path). Not a Claude Code OAuth token.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Which Perceiver builds the payload. dom_snapshot | a11y
SCRAPER_PERCEIVER=dom_snapshot

# Browser
HEADED=false
CDP_PORT=9222

# Logging. DEBUG adds extractor payload sizes and locator uniqueness misses.
LOG_LEVEL=INFO

# DEV ONLY -- carrier credentials, read by the stub in
# `src/trailblazer/shared/dev_carrier_creds.py`. These belong in the
# `carrier_creds` table (login_url, username, password); the stub exists so the
# crawl endpoint can be developed before login/MFA has its own code. The API
# client never sends these -- they are looked up from `carrier_id`.
# Username and password are unused until login is implemented.
CARRIER_URL=
CARRIER_USERNAME=
CARRIER_PASSWORD=
