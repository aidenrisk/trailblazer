# Which provider `get_model()` builds. openrouter | anthropic
LLM_PROVIDER=openrouter

# OpenRouter (primary). Model id verified against https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4.5

# Anthropic Console API key (optional second path). Not a Claude Code OAuth token.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Which Perceiver builds the payload. dom_snapshot | a11y
SCRAPER_PERCEIVER=dom_snapshot

# Browser
HEADED=false
CDP_PORT=9222

# Logging. DEBUG adds extractor payload sizes and locator uniqueness misses.
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# The project Postgres from docker-compose (`docker compose up -d db`). Carriers,
# their credentials, and published login programs live here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15434/trailblazer
# Where the per-carrier login lock is taken. Leave empty to use DATABASE_URL.
# Point at Roadrunner's Postgres when both engines drive the same carriers.
LOGIN_LOCK_DATABASE_URL=

# ── Carrier credentials at rest ──────────────────────────────────────────────
# 32-byte AES-256-GCM key, 64 hex chars (`openssl rand -hex 32`). Same format as
# Roadrunner's RR_CRED_ENCRYPTION_KEY. Empty = passwords stored plaintext (dev only).
CRED_ENCRYPTION_KEY=
# Add a carrier and its login with: uv run python scripts/upsert_carrier_creds.py --help

# ── MFA inbox (shared Aiden backend) ─────────────────────────────────────────
# All three are needed to pull one-time codes; otherwise MFA waits for a human.
AIDEN_BACKEND_URL=
AIDEN_APP_SECRET=
AIDEN_INTERNAL_SECRET=
MFA_TIMEOUT_MS=600000
LOGIN_TEST_MFA_TIMEOUT_MS=180000

# Per-carrier cookie jars and browser profiles.
SESSIONS_DIR=.sessions
